# Database Configuration
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=eduflow_secret_password
POSTGRES_DB=eduflow_db
DATABASE_URL=postgresql://eduflow:eduflow_secret_password@localhost:5432/eduflow_db?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development

# Custom Auth Configuration (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO Self-Hosted Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduflow-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PUBLIC_URL=http://localhost:9000/eduflow-storage
